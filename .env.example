# ==============================================================================
# TradePulse AI - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Webhook Security Secret (Optional header verification from Vapi/Retell)
WEBHOOK_SHARED_SECRET=your_webhook_shared_secret_here

# Supabase Credentials
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Note: Use SERVICE_ROLE key on the backend to bypass RLS for webhook ingestion
SUPABASE_SERVICE_ROLE_KEY=eyJh...your_supabase_service_role_key...

# Twilio Programmable SMS Credentials
# Found in Twilio Console Dashboard
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+441708999888

# Fallback Contractor Contact (Used if assistant ID is unmapped in database)
FALLBACK_CONTRACTOR_PHONE=+447911123456
FALLBACK_CONTRACTOR_NAME="Romford Emergency Plumbing & Heating"
